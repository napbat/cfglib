fn "divide"()
bb0 root:
    -> bb1 fallthrough [Entry]
bb1 head:
    par {
        0[0] <- 1[0]:U32
        1[0] <- 0[0]:U32
    }
    branch less(0[0]:U32, 0x10:U32)
    -> bb2 true [True]
    -> bb4 false [False]
bb2 body:
    emit(0[0]:U32) ! Emit throws
    -> bb4 fallthrough [Fall]
    -> bb3 unwind [Unwind]
bb3 handler:
