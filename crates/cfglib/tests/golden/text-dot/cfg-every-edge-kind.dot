    bb0 -> bb7 [color=purple style=dashed label="ret"];
    bb0 -> bb8 [color=orange style=dotted label="case"];
    bb0 -> bb9 [color=blue style=bold label="jmp"];
    bb0 -> bb10 [color=blue style=dotted label="ijmp"];
    bb0 -> bb11 [color=purple style=dotted label="icall"];
    bb0 -> bb12 [color=darkred style=solid label="handler"];
    bb0 -> bb13 [color=darkred style=dashed label="unwind"];
    bb0 -> bb14 [color=darkred style=dotted label="leave"];
    bb0 -> bb15 [color=darkred style=bold label="resume"];
    bb0 -> bb16 [color=darkgreen style=dashed label="continue"];
}
